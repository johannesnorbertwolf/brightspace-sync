# Copy to .env (same folder) or ~/.config/brightspace-sync/.env.
# Only needed if you enable email or webhook notifications.

# Email notifications (set notify.email.enabled = true in config.json)
BRIGHTSPACE_SMTP_PASSWORD=

# Webhook notifications (set notify.webhook.enabled = true in config.json)
# Posts JSON: {"title": "...", "message": "..."} - works with Slack/Discord/
# Mattermost incoming webhooks.
BRIGHTSPACE_WEBHOOK_URL=

# Telegram notifications (set notify.telegram.enabled = true in config.json)
# Create a bot with @BotFather, message it once, then get your numeric id from
# @userinfobot.
BRIGHTSPACE_TELEGRAM_BOT_TOKEN=
BRIGHTSPACE_TELEGRAM_CHAT_ID=
